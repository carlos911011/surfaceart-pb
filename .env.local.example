# Database (local dev)
DATABASE_URL="file:./dev.db"

# Turso (production) — get from: turso db show <db-name>
# TURSO_AUTH_TOKEN="eyJ..."
# DATABASE_URL="libsql://your-db-name.turso.io"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials
ADMIN_EMAIL="admin@surfaceartpb.com"
ADMIN_PASSWORD="change-this-password"

# Cloudinary (image uploads in production) — get from cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMTP (optional — confirmation emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Email destinations
NOTIFICATION_EMAIL="hello@surfaceartpb.com"

# Public company info
NEXT_PUBLIC_COMPANY_NAME="SurfaceArt Palm Beach"
NEXT_PUBLIC_COMPANY_PHONE="(561) 000-0000"
NEXT_PUBLIC_COMPANY_EMAIL="hello@surfaceartpb.com"

# Optional: Google Maps embed URL
NEXT_PUBLIC_GOOGLE_MAPS_EMBED=""
